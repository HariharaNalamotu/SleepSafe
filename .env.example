# Exact microphone source from: pactl list short sources
AUDIO_SOURCE=bluez_input.REPLACE_WITH_YOUR_SOURCE
DEVICE_ID=pi-01
SPOOL_DIR=/home/ubuntu/SleepSafe/spool
MAX_SPOOL_MB=512
# Gentle rumble/high-frequency filtering; use anull for unfiltered capture.
AUDIO_FILTERS=highpass=f=60,lowpass=f=7000
DATABRICKS_HOST=https://REPLACE_WITH_WORKSPACE_HOST
DATABRICKS_TOKEN=REPLACE_WITH_TOKEN
DATABRICKS_VOLUME=/Volumes/main/sleepsafe/audio/incoming
